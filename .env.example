# Supabase public project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only exchange-rate automation.
CRON_SECRET=generate-a-long-random-secret

# Optional Telegram alerts for exchange-rate failures and recoveries.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Temporary bootstrap values. Remove the password after creating the first admin.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_NAME=System Administrator
# INITIAL_ADMIN_PASSWORD=use-a-strong-temporary-password
