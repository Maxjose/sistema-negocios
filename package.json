{
  "name": "sistema-negocios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "node --env-file=.env scripts/verify-tenant-isolation.mjs",
    "test:sales": "node --env-file=.env scripts/verify-sales-transactions.mjs",
    "test:reports": "node --env-file=.env scripts/verify-business-report.mjs",
    "test:security": "node --env-file=.env scripts/verify-access-security.mjs",
    "test:features": "node --env-file=.env scripts/verify-business-features.mjs",
    "test:sessions": "node --env-file=.env scripts/verify-session-revocation.mjs",
    "test:payments": "node --env-file=.env scripts/verify-mixed-payments.mjs",
    "test:accent": "node --env-file=.env scripts/verify-accent-theme.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:watch": "vitest",
    "admin:create": "node --env-file=.env scripts/create-super-admin.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  }
}
